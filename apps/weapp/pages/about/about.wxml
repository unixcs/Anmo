<view class="page-body">
  <!-- 品牌头 -->
  <view class="brand">
    <view class="seal">安摩</view>
    <view class="brand-title">{{heroTitle || '安摩 · 到店按摩'}}</view>
    <view class="brand-sub">{{heroBody || '专业肩颈腰背放松，静候您的到来。'}}</view>
  </view>

  <!-- 营业状态 -->
  <view wx:if="{{status}}" class="status-pill">
    <view class="status-dot {{statusClass}}"></view>
    <text>当前门店状态：{{status}}</text>
  </view>

  <shop-card address="{{shop.address}}" phone="{{shop.phone}}" latitude="{{shop.latitude}}" longitude="{{shop.longitude}}" />

  <!-- 门店地址/电话/营业状态属顾客资源：从分享进来还没登录时给出入口 -->
  <view wx:if="{{!loggedIn}}" class="cell pressable login-cell" bindtap="goLogin">
    <view class="cell-icon"><app-icon name="lock" size="36" /></view>
    <view class="cell-body"><text class="cell-title">登录后可见更多</text><text class="cell-desc">门店地址、电话与实时营业状态</text></view>
    <view class="chevron"><app-icon name="chevron-right" size="32" /></view>
  </view>

  <!-- 使用说明 -->
  <view class="section-title">使用说明</view>
  <view class="card plain guide">
    <view class="guide-li"><app-icon name="calendar" size="32" /><text>预约：首页 / 预约页选择服务与时间，请提前 2 小时</text></view>
    <view class="guide-li"><app-icon name="qr" size="32" /><text>核销：到店出示核销码，商家扫码后开始服务</text></view>
    <view class="guide-li"><app-icon name="wallet" size="32" /><text>会员卡：结算时可选会员卡扣次，明细随时可查</text></view>
    <view class="guide-li"><app-icon name="pencil" size="32" /><text>改期 / 取消：在「我的预约」中操作</text></view>
  </view>

  <button class="btn outline block share-btn" open-type="share">把门店分享给朋友</button>
</view>
