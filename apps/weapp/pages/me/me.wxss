/* me — 个人中心（头像 + 统计瓦片 + 菜单，与 H5 MePage 同构） */
.me-head {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 6px 4px 20px;
}
.me-avatar {
  width: 56px;
  height: 56px;
  border-radius: var(--radius-full);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 22px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.me-who { flex: 1; min-width: 0; }
.me-name { font-size: 19px; line-height: 26px; font-weight: 700; }
.me-no { font-size: 12px; color: var(--muted-foreground); margin-top: 2px; }

.me-stats { display: flex; gap: 10px; margin-bottom: 20px; }

/* 资料完善度提示条（V2.2 R4，与 H5 MePage 同构） */
.profile-tip {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--primary-soft);
  border-radius: var(--radius-md);
  padding: 8px 12px;
  margin: -8px 4px 16px;
}
.tip-text { flex: 1; font-size: 11px; line-height: 16px; color: var(--foreground); }
.tip-go { flex-shrink: 0; color: var(--primary); font-size: 12px; line-height: 16px; font-weight: 600; }

/* 编辑资料弹层（V2.2 第八批）：结构复用 app.wxss 的 .mask/.sheet，页内不再插卡片 */
.edit-ops { display: flex; gap: 10px; margin-top: 16px; }
.edit-ops .btn { flex: 1; }

/* 菜单 */
.me-menu { margin-bottom: 24px; }

.logout { border-color: var(--border); color: var(--destructive); }
