/* me — 个人中心（头像 + 统计瓦片 + 菜单，与 H5 MePage 同构） */
.me-head {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 6px 4px 20px;
}
.me-avatar {
  width: 56px;
  height: 56px;
  border-radius: var(--radius-full);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 22px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.me-who { flex: 1; min-width: 0; }
.me-name { font-size: 19px; line-height: 26px; font-weight: 700; }
.me-no { font-size: 12px; color: var(--muted-foreground); margin-top: 2px; }

.me-stats { display: flex; gap: 10px; margin-bottom: 20px; }

/* 编辑资料 */
.edit-card { padding: 16px; margin-bottom: 16px; animation: anmo-rise 0.2s var(--ease) both; }
.edit-ops { display: flex; gap: 10px; margin-top: 16px; }
.edit-ops .btn { flex: 1; }

/* 菜单 */
.me-menu { margin-bottom: 24px; }

.logout { border-color: var(--border); color: var(--destructive); }
