<view class="page-body">
  <!-- 品牌头 -->
  <view class="brand">
    <view class="seal">安摩</view>
    <view class="brand-title">欢迎使用安摩</view>
    <view class="brand-sub">微信一键登录，H5 与小程序共用同一个会员账号</view>
  </view>

  <!-- 登录中 -->
  <view wx:if="{{trying}}" class="state">
    <button class="btn primary lg block" loading disabled>微信登录中…</button>
    <view class="state-note">正在建立登录态，请稍候</view>
  </view>

  <!-- 失败重试 -->
  <view wx:elif="{{failed}}" class="state">
    <view class="wx-note">
      <app-icon name="info" size="28" />
      <text>微信登录没有成功，请重试</text>
    </view>
    <button class="btn primary lg block" bindtap="tryWx">重新尝试微信登录</button>
  </view>

  <view class="agree">登录即代表同意到店服务相关约定</view>
</view>
