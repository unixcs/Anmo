/* login — 品牌印章 + 微信一键登录（V2.2：无表单） */
.brand { text-align: center; padding: 96px 0 40px; }

.seal {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 64px;
  height: 64px;
  border-radius: var(--radius-md);
  background: var(--primary);
  color: var(--primary-foreground);
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 2px;
  box-shadow: var(--shadow-card);
  margin-bottom: 14px;
}

.brand-title { font-size: 22px; line-height: 30px; font-weight: 700; margin-bottom: 6px; }
.brand-sub {
  font-size: 13px;
  line-height: 19px;
  color: var(--muted-foreground);
  margin: 0 auto;
  max-width: 280px;
}

.state { display: flex; flex-direction: column; }

.wx-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-size: 12px;
  color: var(--warning);
  margin-bottom: 16px;
}

.state-note {
  text-align: center;
  font-size: 12px;
  color: var(--muted-foreground);
  margin-top: 12px;
}

.agree {
  text-align: center;
  font-size: 12px;
  color: var(--muted-foreground);
  margin-top: 28px;
}
