<view class="page-body">
  <view class="page-head">
    <view class="page-title">我的预约</view>
    <view class="page-sub">待到店的预约可改期或取消</view>
  </view>

  <scroll-view scroll-x class="chip-row filters" enhanced show-scrollbar="{{false}}">
    <view wx:for="{{filters}}" wx:key="key"
          class="chip {{filter === item.key ? 'picked' : ''}}"
          data-key="{{item.key}}" bindtap="setFilter">{{item.label}}</view>
  </scroll-view>

  <!-- 加载骨架 -->
  <block wx:if="{{loading}}">
    <view class="card sk-card"><view class="skeleton sk-line"></view><view class="skeleton sk-line short"></view></view>
    <view class="card sk-card"><view class="skeleton sk-line"></view><view class="skeleton sk-line short"></view></view>
  </block>

  <view wx:elif="{{failed}}" class="empty">
    <view class="empty-icon"><app-icon name="alert" size="40" /></view>
    <view class="empty-main">网络不可用</view>
    <view class="empty-sub">没能取到预约记录，请稍后再试</view>
    <button class="btn outline sm" bindtap="retry">重新加载</button>
  </view>

  <block wx:for="{{list}}" wx:key="id">
    <view class="card apt {{item.status === 'WAITING' ? 'apt-live' : ''}}">
      <view class="apt-head">
        <view class="apt-when">
          <text class="apt-date num">{{item.date}}</text>
          <text class="apt-time num">{{item.time}}</text>
          <text wx:if="{{item.dayTag}}" class="tag">{{item.dayTag}}</text>
        </view>
        <view class="badge {{item.statusClass}}">{{item.statusText}}</view>
      </view>
      <view class="apt-service" wx:if="{{item.service}}">{{item.service}}<text wx:if="{{item.minutes}}" class="apt-minutes num"> · {{item.minutes}} 分钟</text></view>
      <view class="apt-note" wx:if="{{item.note}}">备注：{{item.note}}</view>
      <view class="apt-no num">{{item.no}}</view>

      <view wx:if="{{item.status === 'WAITING' || item.status === 'IN_SERVICE'}}" class="apt-tip">
        <app-icon name="qr" size="14" />
        <text>到店出示「核销码」即可开始服务</text>
        <text class="link" bindtap="goQR">查看</text>
      </view>

      <view wx:if="{{item.canCancel || item.canReschedule}}" class="apt-ops">
        <button wx:if="{{item.canReschedule}}" class="btn outline sm" data-id="{{item.id}}" bindtap="openReschedule">改期</button>
        <button wx:if="{{item.canCancel}}" class="btn ghost sm danger" data-id="{{item.id}}" bindtap="cancel">取消预约</button>
      </view>
    </view>
  </block>

  <view wx:if="{{!loading && !failed && !list.length}}" class="empty">
    <view class="empty-icon"><app-icon name="inbox" size="40" /></view>
    <view class="empty-main">{{filter ? '这个状态下还没有预约' : '还没有预约'}}</view>
    <view class="empty-sub" wx:if="{{!filter}}">选好项目和时间，几分钟就能约好</view>
    <button wx:if="{{!filter}}" class="btn primary sm" bindtap="goBooking">去预约</button>
  </view>

  <!-- 改期抽屉 -->
  <view wx:if="{{reschedule}}" class="mask" bindtap="closeReschedule">
    <view class="sheet" catchtap="">
      <view class="sheet-grab"></view>
      <view class="sheet-title">改期</view>
      <view class="sheet-sub">{{reschedule.when}}{{reschedule.service ? ' · ' + reschedule.service : ''}}</view>
      <scroll-view scroll-x class="chip-row days" enhanced show-scrollbar="{{false}}">
        <view wx:for="{{days}}" wx:key="value"
              class="chip {{dayIdx === index ? 'picked' : ''}}"
              data-idx="{{index}}" bindtap="pickDay">{{item.label}} {{item.sub}}</view>
      </scroll-view>
      <slot-picker options="{{options}}" part="{{part}}" slot="{{slot}}" bind:change="onPick" />
      <view class="sheet-note">同一天改时间会自动排除自身；仅限「待到店」的预约</view>
      <button class="btn primary lg block" disabled="{{busy}}" bindtap="submitReschedule">
        {{busy ? '提交中…' : '确认改期'}}
      </button>
    </view>
  </view>
</view>
