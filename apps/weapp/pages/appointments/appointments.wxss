/* appointments — 我的预约列表 */
.filters { margin-bottom: 14px; }

/* 骨架 */
.sk-card { padding: 16px; }
.sk-line { height: 14px; border-radius: 6px; margin-bottom: 10px; }
.sk-line.short { width: 55%; margin-bottom: 0; }

/* 预约卡 */
.apt { padding: 16px; margin-bottom: 12px; }
.apt-live { border-left: 3px solid var(--primary); }

.apt-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 8px;
}

.apt-when { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }
.apt-date { font-size: 16px; font-weight: 700; }
.apt-time { font-size: 14px; color: var(--foreground); }

.apt-service { font-size: 14px; font-weight: 600; margin-bottom: 2px; }
.apt-minutes { font-weight: 400; color: var(--muted-foreground); font-size: 12px; }
.apt-note {
  font-size: 12px;
  line-height: 18px;
  color: var(--muted-foreground);
  background: var(--muted);
  border-radius: var(--radius-sm);
  padding: 6px 10px;
  margin: 8px 0 2px;
}
.apt-no { font-size: 11px; color: var(--muted-foreground); margin-top: 6px; }

.apt-tip {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--muted-foreground);
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px dashed var(--border);
}
.apt-tip .link { margin-left: auto; font-size: 12px; }

.apt-ops {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 12px;
}

.btn.ghost.danger { color: var(--destructive); }

/* 改期抽屉 */
.days { margin-bottom: 4px; }
