/* home 页（镜像 H5 HomePage） */
.hero {
  padding: 24rpx 0 8rpx;
}

.hero-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.hero-brand {
  display: flex;
  gap: 24rpx;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.seal {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--primary);
  color: var(--primary-foreground);
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  text-indent: 4rpx;
  box-shadow: var(--shadow-card);
}

.hero-text {
  min-width: 0;
}

.hero-title {
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-sub {
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--muted-foreground);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-pill {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  border-radius: var(--radius-full);
  padding: 10rpx 20rpx;
  background: var(--muted);
  color: var(--muted-foreground);
}

.status-pill .status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--muted-foreground);
  animation: anmo-breathe 2s ease-in-out infinite;
}

.status-pill.success {
  background: var(--success-soft);
  color: var(--success);
}

.status-pill.success .status-dot {
  background: var(--success);
}

.status-pill.warning {
  background: var(--warning-soft);
  color: var(--warning);
}

.status-pill.warning .status-dot {
  background: var(--warning);
}

.status-pill.destructive {
  background: var(--destructive-soft);
  color: var(--destructive);
}

.status-pill.destructive .status-dot {
  background: var(--destructive);
}

.hero-cta {
  margin-top: 32rpx;
}

/* 公告 */
.notice {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  margin-top: 24rpx;
}

.notice-tag {
  flex: 0 0 auto;
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 600;
  background: var(--primary-soft);
  border-radius: var(--radius-full);
  padding: 6rpx 16rpx;
}

.notice-body {
  overflow: hidden;
}

.notice-line {
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--muted-foreground);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 服务推荐 */
.section {
  margin-top: 40rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-head-title {
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 600;
}

/* 区块头右侧"全部服务"入口（镜像 H5 .more） */
.section-head-more {
  color: var(--muted-foreground);
  font-size: 26rpx;
}

.svc-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.svc-card {
  width: calc(50% - 10rpx);
  margin-bottom: 0;
  display: flex;
  flex-direction: column;
}

.svc-name {
  font-weight: 600;
  font-size: 30rpx;
  line-height: 42rpx;
}

.svc-meta {
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--muted-foreground);
  margin: 8rpx 0;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.svc-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: auto;
}

.svc-price {
  color: var(--primary);
  font-size: 30rpx;
}

.svc-mins {
  font-size: 24rpx;
  color: var(--muted-foreground);
}

/* 快捷入口 */
.quick {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 0;
}

.quick-item {
  flex: 1;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  color: var(--muted-foreground);
}

.quick-name {
  color: var(--foreground);
  font-weight: 500;
  font-size: 28rpx;
  margin-top: 4rpx;
}

.quick-sub {
  font-size: 22rpx;
}
