.shop-card {
  margin-bottom: 24rpx;
}

.shop-title {
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.shop-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-top: 1px solid var(--border);
  font-size: 28rpx;
}

.shop-label {
  flex: 0 0 auto;
  color: var(--muted-foreground);
  display: flex;
}

.shop-value {
  flex: 1;
  line-height: 1.5;
}

.shop-value.muted {
  color: var(--muted-foreground);
}

.shop-go {
  flex: 0 0 auto;
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 500;
}

.pressed {
  opacity: 0.7;
}
