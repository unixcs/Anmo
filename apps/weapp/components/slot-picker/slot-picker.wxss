/* slot-picker — 上下午 + 具体时间（与 H5 BookingPage 同款视觉） */
.picker { display: flex; flex-direction: column; }

.parts { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.part {
  border: 1px solid var(--border);
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 16px 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
  align-items: center;
  transition: all 0.15s var(--ease);
}
.part.picked { border-color: var(--primary); background: var(--primary-soft); }
.part.off { opacity: 0.45; }
.part-name { font-size: 17px; font-weight: 600; }
.part.picked .part-name { color: var(--primary); }
.part-meta { font-size: 12px; color: var(--muted-foreground); }
.part.picked .part-meta { color: var(--primary); }

.slot-title {
  font-size: 12px;
  color: var(--muted-foreground);
  margin: 14px 0 8px;
}

.slots { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
.slot {
  position: relative;
  border: 1px solid var(--border);
  background: var(--card);
  border-radius: var(--radius-sm);
  padding: 9px 0;
  text-align: center;
  font-size: 13px;
  transition: all 0.15s var(--ease);
}
.slot.full { opacity: 0.4; }
.slot.picked {
  border-color: var(--primary);
  background: var(--primary);
  color: var(--primary-foreground);
  font-weight: 600;
}
.slot-full-badge {
  position: absolute;
  top: -6px;
  right: -4px;
  background: var(--destructive);
  color: #fff;
  font-size: 10px;
  line-height: 1;
  border-radius: var(--radius-full);
  padding: 2px 5px;
}

.hint { font-size: 12px; color: var(--muted-foreground); margin-top: 10px; }
.tip { padding: 10px 0; font-size: 13px; }
.closed-tip {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--muted-foreground);
}
