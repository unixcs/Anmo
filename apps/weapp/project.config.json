{
  "description": "Anmo 顾客端微信小程序（V2，原生）——共用 Anmo Go 后端 /api。",
  "packOptions": {
    "ignore": [
      { "type": "file", "value": "README.md" },
      { "type": "folder", "value": "node_modules" }
    ]
  },
  "setting": {
    "es6": true,
    "postcss": true,
    "minified": true,
    "urlCheck": false,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "compileType": "miniprogram",
  "libVersion": "3.8.10",
  "appid": "touristappid",
  "projectname": "anmo-weapp",
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}
